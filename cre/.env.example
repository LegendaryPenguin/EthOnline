# Values for the Vault DON secrets declared in secrets.yaml.
#
# Copy to cre/.env and fill in. cre/.env is gitignored and must stay that way:
# the risk policy is as sensitive as the key, because publishing it makes the
# signal gameable.

# The Graph gateway key. https://thegraph.com/studio/apikeys/
GRAPH_API_KEY=

# The confidential risk policy, as one line of JSON. Validated by
# lib/signal/policy.ts, which supplies no defaults — a malformed policy fails the
# run rather than publishing a signal under weights nobody chose.
#
# Fields:
#   shocks              ascending collateral declines to evaluate, as fractions
#   assetBeta           per-asset multipliers, keyed by lowercased token address
#   defaultBeta         multiplier for assets absent from assetBeta
#   kAnonymity          minimum distinct accounts behind any published bucket
#   weights             composite score weights; must sum to 1
#   leverageWatchLevel  aggregate leverage ratio counted as levered
#
# The betas below are the ones Phase 4 measured against oracle history
# (docs/evidence/phase4-cascade.md); WETH, wstETH, weETH, WBTC, USDC, USDT.
SENTINEL_RISK_POLICY={"shocks":[0.05,0.1,0.15,0.2,0.3],"assetBeta":{"0xc02aaa39b223fe8d0a0e5c4f27ead9083c756cc2":1,"0x7f39c581f595b53c5cb19bd0b3f8da6c935e2ca0":1.02,"0xcd5fe23c85820f7b72d0926fc9b05b43e359b7ee":1.05,"0x2260fac5e5542a773aa44fbcfedf7c193bc2c599":0.85,"0xa0b86991c6218b36c1d19d4a2e9eb0ce3606eb48":0.01,"0xdac17f958d2ee523a2206206994597c13d831ec7":0.01},"defaultBeta":1,"kAnonymity":5,"weights":{"concentration":0.5,"leverage":0.2,"distress":0.3},"leverageWatchLevel":1.5}

# Only needed to deploy; simulation does not touch a chain.
CRE_ETH_PRIVATE_KEY=
