# Copy to .env.local and fill in. .env.local is gitignored (.gitignore: `.env*`) and must
# stay that way. Sentinel has no mock mode — there is no value you can put here that makes
# it serve fabricated numbers, and a missing or wrong key fails the run loudly. That is the
# whole point: every figure this project publishes is traceable to a query it really made.
#
# Check your setup before running anything else:
#
#   npm run preflight
#
# It validates the key against the live gateway, reports each deployment's sync lag, and
# validates the risk policy without printing it.

# --- Required -----------------------------------------------------------------------------

# The Graph gateway API key. Free, and 100k queries/month covers this project many times
# over. Create one at https://thegraph.com/studio/apikeys/
#
# The key is a path segment of the gateway URL, so it can leak through an error message that
# includes the URL. `lib/graph/client.ts` never puts the URL in a thrown error, and
# `lib/__tests__/no-mock-data.test.ts` asserts this file's variable is read in that one
# module and nowhere else.
GRAPH_API_KEY=

# The confidential risk policy, as one line of JSON.
#
# This is as sensitive as the API key. It is what makes the published signal hard to game:
# if the leverage watch level and the composite weights are public, a borrower can sit one
# basis point under the threshold and stay invisible. It lives inside the enclave in
# production (a Vault DON secret, see cre/secrets.yaml) and in this file locally.
#
# `lib/signal/policy.ts` validates it and supplies NO defaults — a malformed or absent
# policy fails the run rather than publishing a signal under weights nobody chose.
#
# Fields:
#   shocks              ascending collateral declines to evaluate, as fractions of price
#   assetBeta           per-asset shock multipliers, keyed by lowercased token address
#   defaultBeta         multiplier for any asset absent from assetBeta
#   kAnonymity          minimum distinct accounts behind any published bucket
#   weights             composite score weights; must sum to exactly 1
#   leverageWatchLevel  aggregate leverage ratio at or above which debt counts as levered
#
# A working shape (substitute your own numbers — the betas below are the ones Phase 4
# measured against oracle history, documented in docs/evidence/phase4-cascade.md):
#
#   {"shocks":[0.1,0.2,0.3],"assetBeta":{"0x…weth":1.0},"defaultBeta":0.9,
#    "kAnonymity":5,"weights":{"multiProtocol":0.4,"levered":0.3,"shock":0.3},
#    "leverageWatchLevel":2.5}
SENTINEL_RISK_POLICY=

# --- Optional -----------------------------------------------------------------------------

# An Ethereum mainnet RPC endpoint. Only used by the oracle-history verification in
# `scripts/verify-emode.mts`; the analysis pipeline itself runs entirely on The Graph.
RPC_URL=

# How many positions the health-verification script re-derives against the protocols' own
# reported values. Default is a sample; set higher for a slower, stricter check.
VERIFY_SAMPLE=

# Blocks of history the event replay walks back over (`scripts/backtest.mts`).
SENTINEL_EVENT_LOOKBACK=

# --- Deployment only ----------------------------------------------------------------------
#
# `cre workflow simulate` needs neither of these. Deploying the workflow to a DON needs the
# key below, and it belongs in `cre/.env` (also gitignored), not here. Never print it.
# The dev signing keys committed in `lib/signal/dev-sign.ts` exist so the verification path
# is testable offline and must never be reused for anything real.
