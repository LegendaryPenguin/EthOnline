{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    // The `scripts/` programs are run by tsx, which resolves a `./lib/thing.mts` specifier as
    // written; without this, `tsc` rejects the extension that the runtime requires. Safe here
    // because this project emits nothing from tsc (`noEmit`), so no import path is ever rewritten.
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // `cre/` is a separate program: it targets WASM, runs under bun, and has its own
  // tsconfig and its own node_modules. Pulling it in here makes bun's globals collide
  // with @types/node (`console.log` resolves to `never`) and breaks the app build.
  // Type-check it with `npm run cre:typecheck`.
  "exclude": ["node_modules", "cre"]
}
