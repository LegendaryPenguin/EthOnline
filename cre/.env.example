# Values for the Vault DON secrets declared in secrets.yaml.
#
# Copy to cre/.env and fill in. cre/.env is gitignored and must stay that way:
# the risk policy is as sensitive as the key, because publishing it makes the
# signal gameable.

# The Graph gateway key. https://thegraph.com/studio/apikeys/
GRAPH_API_KEY=

# The confidential risk policy, as one line of JSON. Validated by
# lib/signal/policy.ts, which supplies no defaults — a malformed policy fails the
# run rather than publishing a signal under weights nobody chose.
#
# Fields:
#   shocks              ascending collateral declines to evaluate, as fractions
#   assetBeta           per-asset multipliers, keyed by lowercased token address
#   defaultBeta         multiplier for assets absent from assetBeta
#   kAnonymity          minimum distinct accounts behind any published bucket
#   weights             composite score weights; must sum to 1
#   leverageWatchLevel  aggregate leverage ratio counted as levered
#   emode               correlated asset groups and the elevated liquidation
#                       threshold they carry, for the Aave V3 E-Mode
#                       reconstruction the standardized schema cannot express
#
# The betas below are the ones Phase 4 measured against oracle history
# (docs/evidence/phase4-cascade.md); WETH, wstETH, weETH, WBTC, USDC, USDT.
#
# The emode groups are derived, not hand-listed: run `npm run emode:groups`, which
# regresses every collateral asset on the ETH and BTC factors and writes both
# docs/evidence/emode-groups.md and the block to paste here. Hand-guessing them by
# symbol would be exactly the invented parameter this codebase refuses.
SENTINEL_RISK_POLICY={"shocks":[0.05,0.1,0.15,0.2,0.3],"assetBeta":{"0xc02aaa39b223fe8d0a0e5c4f27ead9083c756cc2":1,"0x7f39c581f595b53c5cb19bd0b3f8da6c935e2ca0":1.02,"0xcd5fe23c85820f7b72d0926fc9b05b43e359b7ee":1.05,"0x2260fac5e5542a773aa44fbcfedf7c193bc2c599":0.85,"0xa0b86991c6218b36c1d19d4a2e9eb0ce3606eb48":0.01,"0xdac17f958d2ee523a2206206994597c13d831ec7":0.01},"defaultBeta":1,"kAnonymity":5,"weights":{"concentration":0.5,"leverage":0.2,"distress":0.3},"leverageWatchLevel":1.5,"emode":{"threshold":0.95,"groups":[["0xc02aaa39b223fe8d0a0e5c4f27ead9083c756cc2","0xcd5fe23c85820f7b72d0926fc9b05b43e359b7ee","0x7f39c581f595b53c5cb19bd0b3f8da6c935e2ca0","0xae78736cd615f374d3085123a210448e74fc6393","0xbe9895146f7af43049ca1c1ae358b0541ea49704"],["0x2260fac5e5542a773aa44fbcfedf7c193bc2c599","0xcbb7c0000ab88b473b1f5afd9ef808440eed33bf","0x8236a87084f8b84306f72007f36f2618a5634494","0x18084fba666a33d37592fa2633fd49a74dd93a88"],["0xdac17f958d2ee523a2206206994597c13d831ec7","0xa0b86991c6218b36c1d19d4a2e9eb0ce3606eb48","0x4c9edd5852cd905f086c759e8383e09bff1e68b3","0x9d39a5de30e57443bff2a8307a4256c8797a3497","0x40d16fc0246ad3160ccc09b8d0d3a2cd28ae6c2f","0x6b175474e89094c44da98b954eedeac495271d0f","0x356b8d89c1e1239cbbb9de4815c39a1474d5ba7d","0xc139190f447e929f090edeb554d95abb8b18ac1c","0xe343167631d89b6ffc58b88d6b7fb0228795491d","0xdc035d45d973e3ec169d2276ddab16f1e407384f","0x6c3ea9036406852006290770bedfcaba0e23a0e8","0x59bc9fae5d62b19d4f8d07d758047acb9ee19d34","0x8292bb45bf1ee4d140127049757c2e0ff06317ed","0x5f98805a4e8be255a32880fdec7f6728c6568ba0"]]}}

# Only needed to deploy; simulation does not touch a chain.
CRE_ETH_PRIVATE_KEY=
